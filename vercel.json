{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.almannaigym.com" }],
      "destination": "https://almannaigym.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.almannaigym.com" }],
      "destination": "https://almannaigym.com/:path*",
      "permanent": true
    },
    {
      "source": "/offers",
      "has": [{ "type": "header", "key": "accept-language", "value": "^ar\\b.*$" }],
      "missing": [{ "type": "query", "key": "lang" }],
      "destination": "/offers-ar",
      "permanent": false
    },
    {
      "source": "/book",
      "destination": "/free-trial?utm_source=whatsapp&utm_campaign=A-whatsapp",
      "permanent": false
    },
    {
      "source": "/book-ar",
      "destination": "/free-trial-ar?utm_source=whatsapp&utm_campaign=A-whatsapp",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*(iPhone|iPad|iPod).*" }],
      "destination": "https://apps.apple.com/bh/app/id6814225150",
      "permanent": false
    },
    {
      "source": "/app",
      "has": [{ "type": "header", "key": "user-agent", "value": ".*Android.*" }],
      "destination": "https://play.google.com/store/apps/details?id=com.almannaigym.app",
      "permanent": false
    }
  ]
}
